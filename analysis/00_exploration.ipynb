   "source": [
    "FEATS = [v for v in VARS_CYCLE if v != \"soh_percent\"]\n",
    "FENETRE = 101   # cycles : largeur de la médiane glissante qui retire la tendance de vieillissement\n",
    "\n",
    "brut, detendu = {}, {}\n",
    "for c in cells:\n",
    "    g = cycles_valides(cyc_df[cyc_df[\"cell\"] == c.cell_id])\n",
    "    nom = f\"{c.temperature_degC}°C/{c.c_rate}C\"\n",
    "    brut[nom] = g[FEATS].corrwith(g[\"soh_percent\"], method=\"spearman\")\n",
    "    res = g[VARS_CYCLE].apply(lambda s: s - s.rolling(FENETRE, center=True, min_periods=30).median())\n",
    "    detendu[nom] = res[FEATS].corrwith(res[\"soh_percent\"], method=\"spearman\")\n",
    "\n",
    "rho_brut = pd.DataFrame(brut).round(2)\n",
    "rho_det = pd.DataFrame(detendu).round(2)\n",
    "\n",
    "fig_rho = make_subplots(rows=1, cols=2, horizontal_spacing=0.17,\n",
    "                        subplot_titles=[\"ρ(SOH, variable) brut\",\n",
    "                                        f\"après retrait de la tendance (médiane glissante {FENETRE} cycles)\"])\n",
    "for j, m in enumerate([rho_brut, rho_det], start=1):\n",
    "    fig_rho.add_trace(go.Heatmap(z=m.values, x=list(m.columns), y=list(m.index),\n",
    "                                 colorscale=\"RdBu\", zmid=0, zmin=-1, zmax=1, showscale=(j == 2),\n",
    "                                 text=m.values, texttemplate=\"%{text}\", textfont=dict(size=9)),\n",
    "                      row=1, col=j)\n",
    "apply_figure_layout(\n",
    "    fig_rho, size=\"tall\",\n",
    "    title=\"Corrélation de chaque agrégat avec le SOH, cellule par cellule\",\n",
    "    margin=dict(t=105, r=24, b=110, l=170),\n",
    ")\n",
    "fig_rho.update_yaxes(autorange=\"reversed\")\n",
    "fig_rho.show()\n",
    "rho_brut"
   ]
  },
