    "fig_sig = go.Figure()\n",
    "paires = list(corr_sig)\n",
    "for i, cle in enumerate(paires):\n",
    "    m = corr_sig[cle]\n",
    "    fig_sig.add_trace(go.Heatmap(z=m.values, x=list(m.columns), y=list(m.columns),\n",
    "                                 colorscale=\"RdBu\", zmid=0, zmin=-1, zmax=1, visible=(i == 0),\n",
    "                                 text=m.round(2).values, texttemplate=\"%{text}\"))\n",
    "\n",
    "cond = {c.cell_id: f\"{c.temperature_degC}°C/{c.c_rate}C\" for c in cells}\n",
    "boutons_sig = []\n",
    "for i, (cell_id, etape) in enumerate(paires):\n",
    "    vis = [False] * len(paires)\n",
    "    vis[i] = True\n",
    "    boutons_sig.append(dict(label=f\"{cond[cell_id]} · {etape}\",\n",
    "                            method=\"update\", args=[{\"visible\": vis}]))\n",
    "\n",
    "apply_figure_layout(\n",
    "    fig_sig, size=\"standard\", controls_top=True,\n",
    "    title=\"Niveau échantillon : corrélations entre signaux bruts, par cellule et par étape (Spearman)\",\n",
    "    updatemenus=[dict(buttons=boutons_sig, x=0.02, y=1.08,\n",
    "                      xanchor=\"left\", yanchor=\"bottom\", direction=\"down\")],\n",
    "    margin=dict(t=125, r=24, b=110, l=150),\n",
    ")\n",
    "fig_sig.show()"
   ]
  },
