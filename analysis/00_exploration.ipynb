   "source": [
    "def longest_run(sorted_vals):\n",
    "    if len(sorted_vals) == 0:\n",
    "        return 0\n",
    "    run = best = 1\n",
    "    for d in np.diff(sorted_vals):\n",
    "        run = run + 1 if d == 1 else 1\n",
    "        best = max(best, run)\n",
    "    return best\n",
    "\n",
    "gap_rows = []\n",
    "fig_gap = go.Figure()\n",
    "for i, c in enumerate(cells):\n",
    "    idx = c.soh[\"cycle_number\"].astype(int).to_numpy()\n",
    "    full = np.arange(idx.min(), idx.max() + 1)\n",
    "    missing = np.setdiff1d(full, idx)\n",
    "    gap_rows.append(dict(cell=c.cell_id, n_manquants=len(missing),\n",
    "                          pct_manquants=round(100 * len(missing) / len(full), 2), # pourcentage de données manquantes\n",
    "                          plus_long_trou=longest_run(missing)))\n",
    "    fig_gap.add_trace(go.Scatter(x=missing, y=[i] * len(missing), mode=\"markers\",\n",
    "                                  marker=dict(size=6, symbol=\"line-ns\",\n",
    "                                              line=dict(color=\"crimson\", width=2)),\n",
    "                                  showlegend=False))\n",
    "\n",
