   "source": [
    "raw_df = pd.concat(raw_samples, ignore_index=True)\n",
    "print(f\"{len(raw_df)} points bruts échantillonnés sur {len(cells)} cellules\")\n",
    "print(raw_df.groupby([\"cell\", \"step_type\"]).size().unstack(fill_value=0).to_string())\n",
    "\n",
    "STEP_COLOR = {\"cc_discharge\": \"crimson\", \"cccv_charge\": \"seagreen\",\n",
    "              \"cc_charge\": \"royalblue\", \"rest\": \"gray\"}\n",
    "UNI_COLS = [(\"voltage_V\", \"Tension (V)\"), (\"current_A\", \"Courant (A)\"),\n",
    "            (\"temperature_C\", \"Température mesurée (°C)\")]\n",
    "N_TRACES_CELL = len(UNI_COLS) * len(STEP_COLOR)   # traces ajoutées par cellule\n",
    "\n",
    "def titre_uni(nom):\n",
    "    return f\"Distribution univariée des variables brutes : {nom} (couleur = type de step)\"\n",
    "\n",
    "fig_uni = make_subplots(rows=1, cols=3, subplot_titles=[label for _, label in UNI_COLS])\n",
    "for ci, c in enumerate(cells):\n",
    "    sub = raw_df[raw_df[\"cell\"] == c.cell_id]\n",
    "    for j, (col, _) in enumerate(UNI_COLS, start=1):\n",
    "        for step, color in STEP_COLOR.items():\n",
    "            fig_uni.add_trace(\n",
    "                go.Histogram(x=sub.loc[sub[\"step_type\"] == step, col], name=step,\n",
    "                             marker=dict(color=color), opacity=0.6, nbinsx=60,\n",
    "                             legendgroup=step, showlegend=(j == 1 and ci == 0),\n",
    "                             visible=(ci == 0)),\n",
    "                row=1, col=j)\n",
    "\n",
    "# Un bouton par cellule + la vue poolée : le menu bascule la visibilité d'un\n",
    "# bloc de N_TRACES_CELL traces et réécrit le titre.\n",
    "boutons_uni = [dict(label=\"Toutes les cellules\", method=\"update\",\n",
    "                    args=[{\"visible\": [True] * (len(cells) * N_TRACES_CELL)},\n",
    "                          {\"title.text\": titre_uni(\"6 cellules superposées\")}])]\n",
    "for ci, c in enumerate(cells):\n",
    "    vis = [False] * (len(cells) * N_TRACES_CELL)\n",
    "    vis[ci * N_TRACES_CELL:(ci + 1) * N_TRACES_CELL] = [True] * N_TRACES_CELL\n",
    "    boutons_uni.append(dict(label=f\"{c.temperature_degC}°C / {c.c_rate}C\", method=\"update\",\n",
    "                            args=[{\"visible\": vis}, {\"title.text\": titre_uni(c.cell_id)}]))\n",
    "\n",
    "apply_figure_layout(\n",
    "    fig_uni, size=\"tall\", controls_top=True,\n",
    "    title=titre_uni(cells[0].cell_id),\n",
    "    barmode=\"overlay\",\n",
    "    updatemenus=[dict(buttons=boutons_uni, x=0.02, y=1.06,\n",
    "                      xanchor=\"left\", yanchor=\"bottom\", direction=\"down\")],\n",
    "    legend=dict(x=1.02, y=1.0),\n",
    ")\n",
    "fig_uni.update_yaxes(title_text=\"Nombre de points\", row=1, col=1)\n",
    "for j, (_, label) in enumerate(UNI_COLS, start=1):\n",
    "    fig_uni.update_xaxes(title_text=label, row=1, col=j)\n",
    "fig_uni.show()\n",
    "\n",
    "raw_df.groupby([\"cell\", \"step_type\"]).agg(\n",
    "    n=(\"voltage_V\", \"size\"),\n",
    "    v_med=(\"voltage_V\", \"median\"), v_min=(\"voltage_V\", \"min\"), v_max=(\"voltage_V\", \"max\"),\n",
    "    i_med=(\"current_A\", \"median\"), i_min=(\"current_A\", \"min\"), i_max=(\"current_A\", \"max\"),\n",
    "    t_med=(\"temperature_C\", \"median\"), t_max=(\"temperature_C\", \"max\"),\n",
    ").round(2)"
   ]
  },
