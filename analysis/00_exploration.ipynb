   "source": [
    "K_OBS = [200, 500, 1000, 2000]        # cycles observés avant de prédire\n",
    "HORIZONS = [250, 500, 1000, 2000, 4000]\n",
    "\n",
    "def ajuste_puissance(n, y, p):\n",
    "    \"\"\"a - b*n^p par moindres carrés linéaires à exposant imposé.\"\"\"\n",
    "    X = np.column_stack([np.ones_like(n), n ** p])\n",
    "    coef, *_ = np.linalg.lstsq(X, y, rcond=None)\n",
    "    return lambda m: coef[0] + coef[1] * m ** p\n",
    "\n",
    "FORMES = {\"racine (p=0.5)\": 0.5, \"p=0.8 (baseline)\": 0.8, \"linéaire (p=1)\": 1.0}\n",
    "\n",
    "bt_rows = []\n",
    "for nom, p in FORMES.items():\n",
    "    for k in K_OBS:\n",
    "        for h in HORIZONS:\n",
    "            err = []\n",
    "            for c in cells:\n",
    "                n, y = serie_propre(c)\n",
    "                obs, cible = n <= k, (n > k) & (n <= k + h)\n",
    "                if obs.sum() < 30 or cible.sum() < 20:\n",
    "                    continue\n",
    "                f = ajuste_puissance(n[obs], y[obs], p)\n",
    "                err.append(float(np.mean(np.abs(f(n[cible]) - y[cible]))))\n",
    "            if err:\n",
    "                bt_rows.append(dict(forme=nom, k_observes=k, horizon=h,\n",
    "                                    mae=round(float(np.median(err)), 2), n_cellules=len(err)))\n",
    "bt_df = pd.DataFrame(bt_rows)\n",
    "\n",
    "fig_bt = go.Figure()\n",
    "for nom in FORMES:\n",
    "    for k in K_OBS:\n",
    "        sub = bt_df[(bt_df.forme == nom) & (bt_df.k_observes == k)]\n",
    "        if len(sub):\n",
    "            fig_bt.add_trace(go.Scatter(x=sub.horizon, y=sub.mae, mode=\"lines+markers\",\n",
    "                                        name=f\"{nom}, k={k}\",\n",
    "                                        line=dict(dash=C_DASH.get(0.5 if nom.startswith(\"racine\") else 1.0))))\n",
    "fig_bt.add_hline(y=1.0, line=dict(color=\"crimson\", dash=\"dot\"))\n",
    "apply_figure_layout(fig_bt, size=\"compact\",\n",
    "                    title=\"Backtest : MAE médiane en fonction de l'horizon (ligne rouge = 1 point de SOH)\",\n",
    "                    xaxis_title=\"horizon de prédiction (cycles au-delà de k)\",\n",
    "                    yaxis_title=\"MAE (points de SOH)\", yaxis_type=\"log\")\n",
    "fig_bt.show()\n",
    "bt_df.pivot_table(index=[\"forme\", \"k_observes\"], columns=\"horizon\", values=\"mae\")"
   ]
