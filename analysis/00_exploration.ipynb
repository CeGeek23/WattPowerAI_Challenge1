   "source": [
    "SEUIL_GENOU = 1.5     # multiple de la pente de plateau qui définit le genou\n",
    "\n",
    "def pente_locale(n, y, fenetre=201):\n",
    "    \"\"\"Pente lissée en % de SOH par 1000 cycles.\"\"\"\n",
    "    s = pd.Series(y, index=n).rolling(21, center=True, min_periods=1).median()\n",
    "    s = pd.Series(np.minimum.accumulate(s.to_numpy()), index=s.index)   # SOH décroissant\n",
    "    p = pd.Series(np.gradient(s.to_numpy(), s.index.to_numpy(float)), index=s.index)\n",
    "    return s, p.rolling(fenetre, center=True, min_periods=50).median() * 1000\n",
    "\n",
    "reg_rows = []\n",
    "fig_reg = make_subplots(rows=1, cols=2, subplot_titles=[\n",
    "    \"Pente locale vs cycle\", \"Pente locale vs SOH (le genou est un état, pas une date)\"])\n",
    "for c in cells:\n",
    "    n, y = serie_propre(c)\n",
    "    s, pente = pente_locale(n, y)\n",
    "    idx = s.index.to_numpy(float)\n",
    "    st = style(c)\n",
    "    fig_reg.add_trace(go.Scattergl(x=idx, y=pente, mode=\"lines\", line=dict(color=st[\"color\"], dash=st[\"dash\"]),\n",
    "                                   name=f\"{c.temperature_degC}°C/{c.c_rate}C\", legendgroup=c.cell_id),\n",
    "                      row=1, col=1)\n",
    "    fig_reg.add_trace(go.Scattergl(x=s.to_numpy(), y=pente, mode=\"lines\", line=dict(color=st[\"color\"], dash=st[\"dash\"]),\n",
    "                                   showlegend=False, legendgroup=c.cell_id), row=1, col=2)\n",
    "    a0 = float(np.percentile(y, 99.5))\n",
    "    plateau = float(pente[(idx > 500) & (idx < 0.5 * idx.max())].median())\n",
    "    apres = pente[idx > 500]\n",
    "    genou = apres[apres.abs() > SEUIL_GENOU * abs(plateau)]\n",
    "    reg_rows.append(dict(\n",
    "        cellule=f\"{c.temperature_degC}°C/{c.c_rate}C\",\n",
    "        perte_200_premiers_cycles=round(a0 - float(s[s.index <= 200].iloc[-1]), 2),\n",
    "        plateau_pct_par_1000cyc=round(plateau, 2),\n",
    "        cycle_genou=int(genou.index[0]) if len(genou) else None,\n",
    "        soh_au_genou=round(float(s.loc[genou.index[0]]), 1) if len(genou) else None,\n",
    "    ))\n",
    "\n",
    "apply_figure_layout(fig_reg, size=\"standard\",\n",
    "                    title=\"Trois régimes : rodage, plateau, genou\",\n",
    "                    legend=dict(x=1.02, y=1.0))\n",
    "fig_reg.update_yaxes(title_text=\"pente (% SOH / 1000 cycles)\", row=1, col=1)\n",
    "fig_reg.update_xaxes(title_text=\"cycle_number\", row=1, col=1)\n",
    "fig_reg.update_xaxes(title_text=\"SOH (%)\", autorange=\"reversed\", row=1, col=2)\n",
    "fig_reg.show()\n",
    "\n",
    "reg_df = pd.DataFrame(reg_rows)\n",
    "g = reg_df.dropna(subset=[\"soh_au_genou\"])\n",
    "print(f\"rodage (200 premiers cycles) : {reg_df.perte_200_premiers_cycles.mean():.2f} \"\n",
    "      f\"± {reg_df.perte_200_premiers_cycles.std():.2f} points, soit CV = \"\n",
