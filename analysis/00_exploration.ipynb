   "source": [
    "from statsmodels.stats.diagnostic import acorr_ljungbox\n",
    "from statsmodels.tsa.ar_model import AutoReg\n",
    "from statsmodels.tsa.stattools import adfuller, kpss\n",
    "\n",
    "N_LAGS = 40\n",
    "\n",
    "def acf(x, n_lags):\n",
    "    x = np.asarray(x, float) - np.mean(x)\n",
    "    d = float(np.dot(x, x))\n",
    "    return np.array([1.0] + [float(np.dot(x[:-k], x[k:]) / d) for k in range(1, n_lags + 1)])\n",
    "\n",
    "def pacf_durbin(r):\n",
    "    \"\"\"PACF par la récursion de Durbin-Levinson, à partir de l'ACF.\"\"\"\n",
    "    p = [1.0]\n",
    "    phi = np.zeros((len(r), len(r)))\n",
    "    for k in range(1, len(r)):\n",
    "        if k == 1:\n",
    "            phi[1, 1] = r[1]\n",
    "        else:\n",
    "            num = r[k] - sum(phi[k - 1, j] * r[k - j] for j in range(1, k))\n",
    "            den = 1 - sum(phi[k - 1, j] * r[j] for j in range(1, k))\n",
    "            phi[k, k] = num / den if den != 0 else 0.0\n",
    "            for j in range(1, k):\n",
    "                phi[k, j] = phi[k - 1, j] - phi[k, k] * phi[k - 1, k - j]\n",
    "        p.append(phi[k, k])\n",
    "    return np.array(p)\n",
    "\n",
    "stat_rows, acf_par_cellule = [], {}\n",
    "for c in cells:\n",
    "    n, y, _, _, _, _, res = series_par_cellule[c.cell_id]\n",
    "    dy = np.diff(y) / np.diff(n)\n",
    "    a_res, a_inc = acf(res, N_LAGS), acf(dy, N_LAGS)\n",
    "    acf_par_cellule[c.cell_id] = (a_res, pacf_durbin(a_res), a_inc)\n",
    "    lb = acorr_ljungbox(res, lags=[20], return_df=True)\n",
    "    ar = AutoReg(res, lags=1, old_names=False).fit()\n",
    "    stat_rows.append(dict(\n",
    "        cellule=f\"{c.temperature_degC}°C/{c.c_rate}C\",\n",
    "        adf_soh=round(float(adfuller(y, autolag=\"AIC\")[1]), 3),\n",
    "        adf_delta=round(float(adfuller(dy, autolag=\"AIC\")[1]), 5),\n",
    "        kpss_residu=round(float(kpss(res, regression=\"c\", nlags=\"auto\")[1]), 3),\n",
    "        acf1_residu=round(float(a_res[1]), 2),\n",
    "        pacf2_residu=round(float(acf_par_cellule[c.cell_id][1][2]), 2),\n",
    "        ar1_phi=round(float(ar.params[1]), 2),\n",
    "        ljung_box_p=float(lb[\"lb_pvalue\"].iloc[0]),\n",
    "    ))\n",
    "\n",
    "fig_acf = go.Figure()\n",
    "for i, c in enumerate(cells):\n",
    "    a_res, p_res, a_inc = acf_par_cellule[c.cell_id]\n",
    "    for nom, serie in ((\"ACF résidu\", a_res), (\"PACF résidu\", p_res), (\"ACF ΔSOH\", a_inc)):\n",
    "        fig_acf.add_trace(go.Bar(x=np.arange(len(serie)), y=serie, name=nom, visible=(i == 0)))\n",
    "boutons_acf = []\n",
    "for i, c in enumerate(cells):\n",
    "    vis = [False] * (3 * len(cells))\n",
    "    vis[3 * i:3 * i + 3] = [True] * 3\n",
    "    boutons_acf.append(dict(label=f\"{c.temperature_degC}°C / {c.c_rate}C\", method=\"update\",\n",
    "                            args=[{\"visible\": vis},\n",
    "                                  {\"title.text\": f\"Corrélogrammes : {c.cell_id}\"}]))\n",
    "apply_figure_layout(\n",
    "    fig_acf, size=\"compact\", controls_top=True, barmode=\"group\",\n",
    "    title=f\"Corrélogrammes : {cells[0].cell_id}\",\n",
    "    updatemenus=[dict(buttons=boutons_acf, x=0.02, y=1.08,\n",
    "                      xanchor=\"left\", yanchor=\"bottom\", direction=\"down\")],\n",
    "    xaxis_title=\"décalage (cycles)\", legend=dict(x=0.99, y=0.99, xanchor=\"right\"),\n",
    ")\n",
    "fig_acf.show()\n",
    "pd.DataFrame(stat_rows)"
   ]
