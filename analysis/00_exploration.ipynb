   "source": [
    "PAIRES = [(\"part_cv_pct\", \"Part CV de la charge (%)\"),\n",
    "          (\"v_moy_decharge_V\", \"Tension moyenne de décharge (V)\"),\n",
    "          (\"temp_moy_C\", \"Température moyenne mesurée (°C)\")]\n",
    "N_POINTS = 1200   # sous-échantillonnage : au-delà, le nuage n'apporte rien de plus\n",
    "\n",
    "fig_nu = make_subplots(rows=1, cols=3, subplot_titles=[p[1] for p in PAIRES],\n",
    "                       horizontal_spacing=0.09)\n",
    "for i, c in enumerate(cells):\n",
    "    g = cycles_valides(cyc_df[cyc_df[\"cell\"] == c.cell_id])\n",
    "    if len(g) > N_POINTS:\n",
    "        g = g.iloc[np.linspace(0, len(g) - 1, N_POINTS).round().astype(int)]\n",
    "    for j, (col, _) in enumerate(PAIRES, start=1):\n",
    "        fig_nu.add_trace(go.Scattergl(x=g[col], y=g[\"soh_percent\"], mode=\"markers\",\n",
    "                                      marker=dict(size=3, color=CELL_COLOR[c.cell_id]),\n",
    "                                      visible=(i == 0), showlegend=False),\n",
    "                         row=1, col=j)\n",
    "\n",
    "boutons_nu = []\n",
    "for i, c in enumerate(cells):\n",
    "    vis = [False] * len(cells) * len(PAIRES)\n",
    "    for k in range(len(PAIRES)):\n",
    "        vis[i * len(PAIRES) + k] = True\n",
    "    boutons_nu.append(dict(label=f\"{c.temperature_degC}°C / {c.c_rate}C\",\n",
    "                           method=\"update\", args=[{\"visible\": vis}]))\n",
    "\n",
    "apply_figure_layout(\n",
    "    fig_nu, size=\"standard\", controls_top=True,\n",
    "    title=\"SOH (%) contre les trois agrégats non tautologiques, une cellule à la fois\",\n",
    "    updatemenus=[dict(buttons=boutons_nu, x=0.02, y=1.06,\n",
    "                      xanchor=\"left\", yanchor=\"bottom\", direction=\"down\")],\n",
    ")\n",
    "fig_nu.update_yaxes(title_text=\"SOH (%)\", col=1)\n",
    "for j, (_, label) in enumerate(PAIRES, start=1):\n",
    "    fig_nu.update_xaxes(title_text=label, row=1, col=j)\n",
    "fig_nu.show()"
   ]
  },
