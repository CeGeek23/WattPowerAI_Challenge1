   "source": [
    "T_OBS = sorted({c.temperature_degC for c in cells})  # list of observed temperatures\n",
    "T_STEP = min(np.diff(T_OBS))    # step between observed temperatures: the minimum difference between observed temperatures\n",
    "\n",
    "T_ALL = list(np.arange(T_OBS[0], T_OBS[-1] + T_STEP, T_STEP))\n",
    "C_ALL = sorted({c.c_rate for c in cells})\n",
    "\n",
    "observed = {(c.temperature_degC, c.c_rate) for c in cells}\n",
    "cell_by_condition = {(c.temperature_degC, c.c_rate): c for c in cells}\n",
    "grid = [(t, c) for t in T_ALL for c in C_ALL]\n",
    "obs = [g for g in grid if g in observed]\n",
    "miss = [g for g in grid if g not in observed]\n",
    "sizes = [int(design.loc[(design.temp_degC == t) & (design.c_rate == c), \"cycle_max\"].iloc[0]) for t, c in obs]\n",
    "\n",
    "fig = go.Figure()\n",
    "fig.add_trace(go.Scatter(x=[t for t, c in obs], y=[c for t, c in obs], mode=\"markers+text\",\n",
    "                          marker=dict(size=[18 + s / 150 for s in sizes],\n",
    "                                      color=[CELL_COLOR[cell_by_condition[(t, c)].cell_id] for t, c in obs]),\n",
    "                          text=sizes, textposition=\"top center\", name=\"observé\"))\n",
    "fig.add_trace(go.Scatter(x=[t for t, c in miss], y=[c for t, c in miss], mode=\"markers\",\n",
    "                          marker=dict(size=18, color=\"white\", line=dict(color=\"black\", width=1)),\n",
    "                          name=\"non observé\"))\n",
    "apply_figure_layout(\n",
    "    fig,\n",
    "    size=\"compact\",\n",
    "    title=\"Plan d'expérience T × C-rate, un point par cellule (taille = cycle max observé)\",\n",
    "    xaxis=dict(tickmode=\"array\", tickvals=T_ALL),\n",
    "    xaxis_title=\"Température (°C)\",\n",
    "    yaxis_title=\"C-rate\",\n",
    "    yaxis=dict(tickvals=C_ALL, range=[0.15, 1.55]),\n",
    ")\n",
    "fig.show()"
   ]
  },
