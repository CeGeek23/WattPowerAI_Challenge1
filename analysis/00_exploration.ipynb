   "source": [
    "# Variables retirées de la matrice : consignes de banc quasi constantes\n",
    "# (coupures 2.50 / 3.65 V, courants, durée de repos) et doublons du label\n",
    "# (charge_Ah, durées de décharge). `decharge_Ah` reste comme contrôle : c'est\n",
    "# le SOH lui-même, sa corrélation doit valoir exactement 1.\n",
    "VARS_CYCLE = [\"soh_percent\", \"cycle_number\", \"decharge_Ah\", \"duree_cv_h\",\n",
    "              \"part_cv_pct\", \"temp_moy_C\", \"temp_max_C\", \"amplitude_temp_C\",\n",
    "              \"v_moy_decharge_V\"]\n",
    "\n",
    "def cycles_valides(g):\n",
    "    \"\"\"Cycles labellisés et complets : écarte les cycles partiels et les charges cc_charge.\"\"\"\n",
    "    g = g.replace([np.inf, -np.inf], np.nan)\n",
    "    ok = g[\"soh_percent\"].notna() & (g[\"charge_Ah\"] > 60) & (g[\"decharge_Ah\"] > 60)\n",
    "    return g[ok].sort_values(\"cycle_number\")\n",
    "\n",
    "fig_cyc = go.Figure()\n",
    "for i, c in enumerate(cells):\n",
    "    m = cycles_valides(cyc_df[cyc_df[\"cell\"] == c.cell_id])[VARS_CYCLE].corr(method=\"spearman\")\n",
    "    fig_cyc.add_trace(go.Heatmap(z=m.values, x=list(m.columns), y=list(m.columns),\n",
    "                                 colorscale=\"RdBu\", zmid=0, zmin=-1, zmax=1, visible=(i == 0),\n",
    "                                 text=m.round(2).values, texttemplate=\"%{text}\",\n",
    "                                 textfont=dict(size=9)))\n",
    "\n",
    "boutons_cyc = []\n",
    "for i, c in enumerate(cells):\n",
    "    vis = [False] * len(cells)\n",
    "    vis[i] = True\n",
    "    boutons_cyc.append(dict(label=f\"{c.temperature_degC}°C / {c.c_rate}C\",\n",
    "                            method=\"update\", args=[{\"visible\": vis}]))\n",
    "\n",
    "apply_figure_layout(\n",
    "    fig_cyc, size=\"tall\", controls_top=True,\n",
    "    title=\"Niveau cycle : corrélations entre agrégats, une cellule à la fois (Spearman)\",\n",
    "    updatemenus=[dict(buttons=boutons_cyc, x=0.02, y=1.06,\n",
    "                      xanchor=\"left\", yanchor=\"bottom\", direction=\"down\")],\n",
    "    margin=dict(t=125, r=24, b=150, l=170),\n",
    ")\n",
    "fig_cyc.show()"
   ]
  },
