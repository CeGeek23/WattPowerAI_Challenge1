   "source": [
    "# Seule lecture disque de la section : deux colonnes suffisent pour dater les cycles.\n",
    "PAUSE_MIN_J = 3.0\n",
    "\n",
    "dates = {}\n",
    "for c in cells:\n",
    "    ts = c.time_series()[[\"cycle_number\", \"absolute_time\"]]\n",
    "    ts[\"absolute_time\"] = pd.to_datetime(ts[\"absolute_time\"])\n",
    "    dates[c.cell_id] = ts.groupby(\"cycle_number\")[\"absolute_time\"].agg([\"min\", \"max\"])\n",
    "    del ts\n",
    "\n",
    "horloge_rows, pause_rows = [], []\n",
    "fig_hor = make_subplots(rows=1, cols=2, subplot_titles=[\"SOH vs cycle\", \"SOH vs temps calendaire\"])\n",
    "for c in cells:\n",
    "    n, y = serie_propre(c)\n",
    "    d = dates[c.cell_id].reindex(n.astype(int))\n",
    "    jours = (d[\"min\"] - d[\"min\"].iloc[0]).dt.total_seconds().to_numpy() / 86400\n",
    "    st = style(c)\n",
    "    fig_hor.add_trace(go.Scattergl(x=n, y=y, mode=\"lines\", line=dict(color=st[\"color\"], dash=st[\"dash\"]),\n",
    "                                   name=f\"{c.temperature_degC}°C/{c.c_rate}C\", legendgroup=c.cell_id),\n",
    "                      row=1, col=1)\n",
    "    fig_hor.add_trace(go.Scattergl(x=jours, y=y, mode=\"lines\", line=dict(color=st[\"color\"], dash=st[\"dash\"]),\n",
    "                                   showlegend=False, legendgroup=c.cell_id), row=1, col=2)\n",
    "    horloge_rows.append(dict(cellule=f\"{c.temperature_degC}°C/{c.c_rate}C\",\n",
    "                             duree_jours=round(float(jours[-1]), 0),\n",
    "                             cycles_par_jour=round(len(n) / max(jours[-1], 1), 2),\n",
    "                             fade_par_1000cyc=round((y[0] - y[-1]) / (n[-1] - n[0]) * 1000, 2),\n",
    "                             fade_par_100j=round((y[0] - y[-1]) / max(jours[-1], 1) * 100, 2)))\n",
    "\n",
    "    # Effet d'une interruption : SOH juste avant vs juste après. On n'garde que les\n",
    "    # pauses SANS cycle sauté (n contigu), sinon on mesurerait la dégradation\n",
    "    # normale des cycles manquants au lieu de l'effet du repos.\n",
    "    ecart = (d[\"min\"].to_numpy()[1:] - d[\"max\"].to_numpy()[:-1]) / np.timedelta64(1, \"D\")\n",
    "    contigu = np.diff(n) == 1\n",
    "    for k in np.where((ecart > PAUSE_MIN_J) & contigu)[0]:\n",
    "        avant, apres = y[max(0, k - 9):k + 1], y[k + 1:k + 11]\n",
    "        if len(avant) >= 3 and len(apres) >= 3:\n",
    "            pause_rows.append(dict(cellule=f\"{c.temperature_degC}°C/{c.c_rate}C\",\n",
    "                                   cycle=int(n[k]), soh=round(float(y[k]), 1),\n",
    "                                   jours=round(float(ecart[k]), 1),\n",
    "                                   saut_soh=round(float(np.median(apres) - np.median(avant)), 2)))\n",
    "\n",
    "apply_figure_layout(fig_hor, size=\"standard\", title=\"Deux horloges : cycles et calendrier\",\n",
    "                    legend=dict(x=1.02, y=1.0))\n",
    "fig_hor.update_yaxes(title_text=\"SOH (%)\", row=1, col=1)\n",
    "fig_hor.update_xaxes(title_text=\"cycle_number\", row=1, col=1)\n",
    "fig_hor.update_xaxes(title_text=\"jours depuis le premier cycle\", row=1, col=2)\n",
    "fig_hor.show()\n",
    "\n",
    "pause_df = pd.DataFrame(pause_rows).sort_values(\"saut_soh\")\n",
    "print(pd.DataFrame(horloge_rows).to_string(index=False))\n",
    "print(f\"\\n{len(pause_df)} pauses > {PAUSE_MIN_J:.0f} jours · saut médian de SOH = \"\n",
    "      f\"{pause_df.saut_soh.median():+.2f} point · pire cas = {pause_df.saut_soh.min():+.2f}\")\n",
    "pause_df.head(8)"
   ]
