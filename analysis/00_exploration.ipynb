    "def cycle_aggregates(ts):\n",
    "    ts[\"absolute_time\"] = pd.to_datetime(ts[\"absolute_time\"])\n",
    "    dis = ts.loc[ts[\"step_type\"] == \"cc_discharge\"].groupby(\"cycle_number\")[\"step_capacity_Ah\"].max()\n",
    "    chg = ts.loc[ts[\"step_type\"] == \"cccv_charge\"].groupby(\"cycle_number\")[\"step_capacity_Ah\"].max()\n",
    "    g = ts.groupby(\"cycle_number\")\n",
    "    out = pd.DataFrame({\n",
    "        \"discharge_Ah\": dis,\n",
    "        \"charge_Ah\": chg,\n",
    "        \"temp_mean_C\": g[\"temperature_C\"].mean(),\n",
    "        \"temp_max_C\": g[\"temperature_C\"].max(),\n",
    "        \"duree_h\": (g[\"absolute_time\"].max() - g[\"absolute_time\"].min()).dt.total_seconds() / 3600,\n",
    "    })\n",
    "    return out.reset_index()\n",
    "\n",
    "life_frames = []\n",
    "for c in cells:\n",
    "    ts = c.time_series()\n",
    "    agg = cycle_aggregates(ts)\n",
    "    agg.insert(0, \"cell\", c.cell_id)\n",
    "    agg[\"temp_degC\"] = c.temperature_degC\n",
    "    agg[\"c_rate\"] = c.c_rate\n",
    "    agg[\"ecart_temp_C\"] = agg[\"temp_mean_C\"] - c.temperature_degC\n",
    "    life_frames.append(agg)\n",
    "    del ts\n",
    "\n",
    "life_df = pd.concat(life_frames, ignore_index=True)\n",
    "print(f\"{len(life_df)} cycles agrégés au total sur {len(cells)} cellules\")\n",
    "life_df.groupby(\"cell\")[[\"discharge_Ah\", \"ecart_temp_C\", \"duree_h\"]].describe().round(2)"
   ]
  },
