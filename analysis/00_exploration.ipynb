   "source": [
    "LISSAGE = 101      # fenêtre de la médiane glissante qui sépare tendance et résidu\n",
    "\n",
    "def serie_propre(cell):\n",
    "    \"\"\"SOH labellisé, trié, débarrassé des cycles partiels résiduels.\"\"\"\n",
    "    d = cell.soh.dropna(subset=[\"soh_percent\"]).sort_values(\"cycle_number\")\n",
    "    n = d[\"cycle_number\"].to_numpy(float)\n",
    "    y = d[\"soh_percent\"].to_numpy(float)\n",
    "    med = pd.Series(y).rolling(15, center=True, min_periods=1).median().to_numpy()\n",
    "    keep = np.abs(y - med) <= 4.0\n",
    "    return n[keep], y[keep]\n",
    "\n",
    "def dater(cell):\n",
    "    \"\"\"Date de début de chaque cycle : la saisonnalité vit en temps calendaire.\"\"\"\n",
    "    ts = cell.time_series()[[\"cycle_number\", \"absolute_time\"]]\n",
    "    ts[\"absolute_time\"] = pd.to_datetime(ts[\"absolute_time\"])\n",
    "    return ts.groupby(\"cycle_number\")[\"absolute_time\"].min()\n",
    "\n",
    "def decompose(n, y, jours, fenetre=LISSAGE):\n",
    "    \"\"\"y = tendance + saison + résidu (modèle additif du cours).\n",
    "\n",
    "    La tendance est une médiane glissante en cycles ; la saison est un terme\n",
    "    sinusoïdal de période 1 an ajusté sur le détrendu, en temps calendaire —\n",
    "    c'est la seule périodicité que ce banc puisse produire.\n",
    "    \"\"\"\n",
    "    tendance = pd.Series(y).rolling(fenetre, center=True, min_periods=fenetre // 4).median()\n",
    "    tendance = tendance.bfill().ffill().to_numpy()\n",
    "    detrende = y - tendance\n",
    "    ok = np.isfinite(jours) & np.isfinite(detrende)\n",
    "    saison = np.zeros_like(y)\n",
    "    if ok.sum() > 50:\n",
    "        j = jours[ok]\n",
    "        X = np.column_stack([np.ones_like(j), np.cos(2 * np.pi * j / 365.25),\n",
    "                             np.sin(2 * np.pi * j / 365.25)])\n",
    "        b, *_ = np.linalg.lstsq(X, detrende[ok], rcond=None)\n",
    "        Xt = np.column_stack([np.ones_like(jours), np.cos(2 * np.pi * jours / 365.25),\n",
    "                              np.sin(2 * np.pi * jours / 365.25)])\n",
    "        saison = np.where(np.isfinite(jours), Xt @ b - b[0], 0.0)\n",
    "    return tendance, saison, detrende - saison\n",
    "\n",
    "PANNEAUX = [\"série observée\", \"tendance\", \"saison (période 1 an)\", \"résidu\"]\n",
    "fig_dec = make_subplots(rows=4, cols=1, shared_xaxes=True, subplot_titles=PANNEAUX)\n",
    "dec_rows, series_par_cellule = [], {}\n",
    "for i, c in enumerate(cells):\n",
    "    n, y = serie_propre(c)\n",
    "    dates = dater(c).reindex(n.astype(int))\n",
    "    jours = (dates - dates.min()).dt.total_seconds().to_numpy() / 86400\n",
    "    jour_an = dates.dt.dayofyear.to_numpy(float)\n",
    "    tend, sais, res = decompose(n, y, jour_an)\n",
    "    series_par_cellule[c.cell_id] = (n, y, jours, jour_an, tend, sais, res)\n",
    "    st = style(c)\n",
    "    for row, serie in enumerate([y, tend, sais, res], start=1):\n",
    "        fig_dec.add_trace(go.Scattergl(x=n, y=serie, mode=\"lines\", visible=(i == 0),\n",
    "                                       line=dict(color=st[\"color\"], width=1.2), showlegend=False),\n",
    "                          row=row, col=1)\n",
    "    dec_rows.append(dict(cellule=f\"{c.temperature_degC}°C/{c.c_rate}C\", n_points=len(n),\n",
    "                         etendue_tendance=round(float(tend.max() - tend.min()), 2),\n",
    "                         amplitude_saison=round(float(sais.max() - sais.min()), 3),\n",
    "                         sigma_residu=round(float(res.std()), 4),\n",
    "                         part_tendance_pct=round(100 * tend.var() / y.var(), 2),\n",
    "                         part_saison_pct=round(100 * sais.var() / y.var(), 3),\n",
    "                         part_residu_pct=round(100 * res.var() / y.var(), 3)))\n",
    "\n",
    "boutons_dec = []\n",
    "for i, c in enumerate(cells):\n",
    "    vis = [False] * (4 * len(cells))\n",
    "    vis[4 * i:4 * i + 4] = [True] * 4\n",
    "    boutons_dec.append(dict(label=f\"{c.temperature_degC}°C / {c.c_rate}C\", method=\"update\",\n",
    "                            args=[{\"visible\": vis},\n",
    "                                  {\"title.text\": f\"Décomposition additive : {c.cell_id}\"}]))\n",
    "apply_figure_layout(\n",
    "    fig_dec, size=\"tall\", controls_top=True,\n",
    "    title=f\"Décomposition additive : {cells[0].cell_id}\",\n",
    "    updatemenus=[dict(buttons=boutons_dec, x=0.02, y=1.04,\n",
    "                      xanchor=\"left\", yanchor=\"bottom\", direction=\"down\")],\n",
    ")\n",
    "fig_dec.update_xaxes(title_text=\"cycle_number\", row=4, col=1)\n",
    "fig_dec.show()\n",
    "pd.DataFrame(dec_rows)"
   ]
  },
