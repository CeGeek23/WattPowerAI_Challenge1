    "N_PICKS = 100\n",
    "SIGNALS = [(\"voltage_V\", \"Tension (V)\"), (\"current_A\", \"Courant (A)\"), (\"temperature_C\", \"Température (°C)\")]\n",
    "PICK_DASH = [\"solid\", \"dot\", \"dash\"]\n",
    "RAW_SAMPLE_COLS = [\"step_type\", \"voltage_V\", \"current_A\", \"temperature_C\"]\n",
    "\n",
    "fig_raw = make_subplots(rows=3, cols=1, shared_xaxes=True, subplot_titles=[s[1] for s in SIGNALS])\n",
    "steps_by_cell = {c.cell_id: [] for c in cells}\n",
    "raw_samples = []  # échantillon brut par cellule, réutilisé en §5bis (analyse univariée)\n",
    "\n",
    "for ci, c in enumerate(cells):\n",
    "    ts = c.time_series()\n",
    "\n",
    "    samp = ts.sample(n=min(15000, len(ts)), random_state=0)[RAW_SAMPLE_COLS].copy()\n",
    "    samp.insert(0, \"cell\", c.cell_id)\n",
    "    samp.insert(1, \"temp_degC\", c.temperature_degC)\n",
    "    samp.insert(2, \"c_rate\", c.c_rate)\n",
    "    raw_samples.append(samp)\n",
    "\n",
    "    valid = c.soh.loc[c.soh[\"soh_percent\"].notna(), \"cycle_number\"].to_numpy()\n",
    "    picks = valid[np.linspace(0, len(valid) - 1, N_PICKS).round().astype(int)]\n",
    "    for pi, cyc in enumerate(picks):\n",
    "        d = ts[ts[\"cycle_number\"] == cyc].drop_duplicates().copy()\n",
    "        d[\"absolute_time\"] = pd.to_datetime(d[\"absolute_time\"])\n",
    "        d = d.sort_values(\"absolute_time\")\n",
    "        d[\"t_s\"] = (d[\"absolute_time\"] - d[\"absolute_time\"].iloc[0]).dt.total_seconds()\n",
    "        first = (ci == 0 and pi == 0)\n",
    "        for row, (col, _) in enumerate(SIGNALS, start=1):\n",
    "            fig_raw.add_trace(go.Scattergl(x=d[\"t_s\"], y=d[col], mode=\"lines\",\n",
    "                                            line=dict(color=CELL_COLOR[c.cell_id],\n",
    "                                                      dash=PICK_DASH[pi % len(PICK_DASH)]),\n",
    "                                            showlegend=False, visible=first),\n",
    "                               row=row, col=1)\n",
    "        vis = [False] * len(cells) * N_PICKS * len(SIGNALS)\n",
    "        step_idx = ci * N_PICKS + pi\n",
    "        for k in range(len(SIGNALS)):\n",
    "            vis[step_idx * len(SIGNALS) + k] = True\n",
    "        steps_by_cell[c.cell_id].append(dict(method=\"update\", args=[{\"visible\": vis}],\n",
    "                                              label=f\"cycle {int(cyc)}\"))\n",
    "    del ts\n",
    "\n",
    "# Chaque cellule a son propre jeu de pas (N_PICKS=100) : le menu déroulant change de\n",
    "# cellule ET remplace les pas du slider par ceux de cette cellule (plutôt qu'un seul\n",
    "# slider continu à 600 pas mélangeant les 6), pour que le curseur ne scrute jamais\n",
    "# que les cycles de la cellule affichée.\n",
    "cell_buttons = [\n",
    "    dict(label=f\"{c.temperature_degC}°C / {c.c_rate}C\", method=\"update\",\n",
    "         args=[steps_by_cell[c.cell_id][0][\"args\"][0],\n",
    "               {\"sliders[0].steps\": steps_by_cell[c.cell_id],\n",
    "                \"sliders[0].active\": 0,\n",
    "                \"sliders[0].currentvalue.prefix\": f\"{c.temperature_degC}°C/{c.c_rate}C · \"}])\n",
    "    for c in cells\n",
    "]\n",
    "\n",
    "apply_figure_layout(\n",
    "    fig_raw,\n",
    "    size=\"tall\",\n",
    "    title=\"Vue brute d'un cycle : sélecteur de cellule + curseur de cycle (style = stade)\",\n",
    "    updatemenus=[dict(buttons=cell_buttons, x=0.02, y=1.08,\n",
    "                      xanchor=\"left\", yanchor=\"bottom\", direction=\"down\")],\n",
    "    sliders=[dict(active=0,\n",
    "                  currentvalue=dict(prefix=f\"{cells[0].temperature_degC}°C/{cells[0].c_rate}C · \"),\n",
    "                  pad=dict(t=8), steps=steps_by_cell[cells[0].cell_id], x=0.08, y=-0.11, len=0.84,\n",
    "                  xanchor=\"left\", yanchor=\"top\")],\n",
    "    margin=dict(t=125, r=24, b=125, l=70),\n",
    ")\n",
    "for row, (_, label) in enumerate(SIGNALS, start=1):\n",
    "    fig_raw.update_yaxes(title_text=label, row=row, col=1)\n",
    "fig_raw.update_xaxes(title_text=\"temps écoulé (s)\", row=3, col=1)\n",
    "fig_raw.show()"
   ]
