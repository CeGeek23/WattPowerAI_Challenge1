   "source": [
    "def composante_annuelle(jours, valeurs):\n",
    "    \"\"\"Amplitude et R2 d'un terme sinusoïdal de période 1 an.\"\"\"\n",
    "    ok = np.isfinite(valeurs)\n",
    "    j, v = np.asarray(jours, float)[ok], np.asarray(valeurs, float)[ok]\n",
    "    if len(v) < 50 or np.var(v) == 0:\n",
    "        return np.nan, np.nan\n",
    "    X = np.column_stack([np.ones_like(j), np.cos(2 * np.pi * j / 365.25),\n",
    "                         np.sin(2 * np.pi * j / 365.25)])\n",
    "    b, *_ = np.linalg.lstsq(X, v, rcond=None)\n",
    "    return float(np.hypot(b[1], b[2])), float(1 - np.var(v - X @ b) / np.var(v))\n",
    "\n",
    "saison_rows = []\n",
    "fig_sai = make_subplots(rows=1, cols=2, subplot_titles=[\n",
    "    \"Écart température mesurée - consigne, par mois calendaire\",\n",
    "    \"Résidu de SOH, par mois calendaire\"])\n",
    "for c in cells:\n",
    "    n, y, _, jour, _, _, res = series_par_cellule[c.cell_id]\n",
    "    dates = dater(c).reindex(n.astype(int))\n",
    "    ts = c.time_series()[[\"cycle_number\", \"temperature_C\"]]\n",
    "    tmoy = ts.groupby(\"cycle_number\")[\"temperature_C\"].mean().reindex(n.astype(int)).to_numpy()\n",
    "    del ts\n",
    "    ecart = tmoy - c.temperature_degC\n",
    "    amp_t, r2_t = composante_annuelle(jour, ecart)\n",
    "    amp_s, r2_s = composante_annuelle(jour, res)\n",
    "    saison_rows.append(dict(cellule=f\"{c.temperature_degC}°C/{c.c_rate}C\",\n",
    "                            jours_couverts=int((dates.max() - dates.min()).days),\n",
    "                            amp_annuelle_temp_degC=round(amp_t, 2), r2_temp=round(r2_t, 2),\n",
    "                            amp_annuelle_soh_pts=round(amp_s, 3), r2_soh=round(r2_s, 2)))\n",
    "    mois = dates.dt.month.to_numpy()\n",
    "    st = style(c)\n",
    "    for col, serie in ((1, ecart), (2, res)):\n",
    "        m = pd.DataFrame({\"mois\": mois, \"v\": serie}).groupby(\"mois\")[\"v\"].median()\n",
    "        fig_sai.add_trace(go.Scatter(x=m.index, y=m.to_numpy(), mode=\"lines+markers\",\n",
    "                                     line=dict(color=st[\"color\"], dash=st[\"dash\"]),\n",
    "                                     name=f\"{c.temperature_degC}°C/{c.c_rate}C\",\n",
    "                                     legendgroup=c.cell_id, showlegend=(col == 1)),\n",
    "                          row=1, col=col)\n",
    "\n",
    "apply_figure_layout(fig_sai, size=\"standard\",\n",
    "                    title=\"La saisonnalité est dans le banc, pas dans le SOH\",\n",
    "                    legend=dict(x=1.02, y=1.0))\n",
    "fig_sai.update_xaxes(title_text=\"mois\", tickmode=\"linear\", dtick=1)\n",
    "fig_sai.update_yaxes(title_text=\"°C\", row=1, col=1)\n",
    "fig_sai.update_yaxes(title_text=\"points de SOH\", row=1, col=2)\n",
    "fig_sai.show()\n",
    "pd.DataFrame(saison_rows)"
   ]
