    "import os, sys\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from scipy import stats\n",
    "import plotly.colors as pc\n",
    "import plotly.graph_objects as go\n",
    "from plotly.subplots import make_subplots\n",
    "\n",
    "ROOT = os.getcwd()\n",
    "while not os.path.isdir(os.path.join(ROOT, \"dataset\")) and os.path.dirname(ROOT) != ROOT:\n",
    "    ROOT = os.path.dirname(ROOT)\n",
    "sys.path.insert(0, ROOT)\n",
    "DATA = os.path.join(ROOT, \"dataset\")\n",
    "\n",
    "from framework.data import load_cells\n",
    "\n",
    "cells = load_cells(DATA, verbose=True) # verbose=True to see the list of loaded cells\n",
    "cells = sorted(cells, key=lambda c: (c.temperature_degC, c.c_rate)) # to sort the cells by temperature and C-rate\n",
    "\n",
    "CELL_COLORS = pc.sample_colorscale(\"Turbo\", [i / max(1, len(cells) - 1) for i in range(len(cells))])\n",
    "CELL_COLOR = {c.cell_id: color for c, color in zip(cells, CELL_COLORS)}\n",
    "C_DASH = {0.5: \"dash\", 1.0: \"solid\"}\n",
    "\n",
    "FIGURE_SIZE = {\n",
    "    \"compact\": (920, 420),\n",
    "    \"standard\": (1020, 560),\n",
    "    \"tall\": (1020, 760),\n",
    "}\n",
    "BASE_MARGIN = dict(t=95, r=24, b=60, l=70)\n",
    "\n",
    "def style(cell):\n",
    "    return dict(color=CELL_COLOR[cell.cell_id], dash=C_DASH[cell.c_rate])\n",
    "\n",
    "def apply_figure_layout(fig, size=\"standard\", *, title=None, controls_top=False, **layout_kwargs):\n",
    "    width, height = FIGURE_SIZE[size]\n",
    "    margin = dict(BASE_MARGIN)\n",
    "    if controls_top:\n",
    "        margin[\"t\"] = max(margin[\"t\"], 125)\n",
    "\n",
    "    layout = dict(width=width, height=height, margin=margin, template=\"plotly_white\")\n",
    "    if title is not None:\n",
    "        layout[\"title\"] = dict(text=title, x=0.5, y=0.98, xanchor=\"center\", yanchor=\"top\")\n",
    "    layout.update(layout_kwargs)\n",
    "    fig.update_layout(**layout)\n",
    "\n",
    "[repr(c) for c in cells]"
   ]
  },
