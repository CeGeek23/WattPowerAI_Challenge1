    "DT_S = 30.0                    # pas d'échantillonnage du banc, constant\n",
    "CLE = [\"cycle_number\", \"step_type\", \"absolute_time\"]\n",
    "SIG = [\"t_etape_s\", \"voltage_V\", \"current_A\", \"temperature_C\", \"step_capacity_Ah\"]\n",
    "ETAPES = [\"cc_discharge\", \"cccv_charge\", \"cc_charge\", \"toutes\"]\n",
    "\n",
    "def charge_propre(cell):\n",
    "    \"\"\"Time series dédoublonnée, triée, avec le temps écoulé depuis le début de l'étape.\"\"\"\n",
    "    ts = cell.time_series()\n",
    "    ts[\"absolute_time\"] = pd.to_datetime(ts[\"absolute_time\"])\n",
    "    n_brut = len(ts)\n",
    "    ts = (ts.drop_duplicates(subset=CLE)\n",
    "            .sort_values([\"cycle_number\", \"absolute_time\"], kind=\"mergesort\"))\n",
    "    nouvelle = ((ts[\"step_type\"] != ts[\"step_type\"].shift())\n",
    "                | (ts[\"cycle_number\"] != ts[\"cycle_number\"].shift()))\n",
    "    ts[\"t_etape_s\"] = (ts.groupby(nouvelle.cumsum())[\"absolute_time\"]\n",
    "                         .transform(lambda s: (s - s.iloc[0]).dt.total_seconds()))\n",
    "    return ts, n_brut\n",
    "\n",
    "def features_par_cycle(ts, cell):\n",
    "    \"\"\"Un enregistrement par cycle : capacités, durées, part CV, températures, tensions.\"\"\"\n",
    "    i_nom = cell.c_rate * 102.0\n",
    "    dech = ts[ts[\"step_type\"] == \"cc_discharge\"]\n",
    "    char = ts[ts[\"step_type\"] == \"cccv_charge\"]\n",
    "    gd, gc = dech.groupby(\"cycle_number\"), char.groupby(\"cycle_number\")\n",
    "    actif = pd.concat([dech, char]).groupby(\"cycle_number\")\n",
    "    f = pd.DataFrame({\n",
    "        \"decharge_Ah\": gd[\"step_capacity_Ah\"].max(),\n",
    "        \"charge_Ah\": gc[\"step_capacity_Ah\"].max(),\n",
    "        \"duree_charge_h\": gc.size() * DT_S / 3600,\n",
    "        \"duree_cv_h\": (char[char[\"current_A\"].abs() < 0.9 * i_nom]\n",
    "                       .groupby(\"cycle_number\").size() * DT_S / 3600),\n",
    "        \"temp_moy_C\": actif[\"temperature_C\"].mean(),\n",
    "        \"temp_max_C\": actif[\"temperature_C\"].max(),\n",
    "        \"temp_min_C\": actif[\"temperature_C\"].min(),\n",
    "        \"v_moy_decharge_V\": gd[\"voltage_V\"].mean(),\n",
    "    })\n",
    "    f[\"duree_cv_h\"] = f[\"duree_cv_h\"].fillna(0.0)\n",
    "    f[\"part_cv_pct\"] = 100 * f[\"duree_cv_h\"] / f[\"duree_charge_h\"]\n",
    "    f[\"amplitude_temp_C\"] = f[\"temp_max_C\"] - f[\"temp_min_C\"]\n",
    "    return f.reset_index().merge(cell.soh, on=\"cycle_number\", how=\"left\")\n",
    "\n",
    "cyc_frames, corr_sig, qualite = [], {}, []\n",
    "for c in cells:\n",
    "    ts, n_brut = charge_propre(c)\n",
    "    qualite.append(dict(cell=c.cell_id, n_lignes_brutes=n_brut,\n",
    "                        pct_lignes_dupliquees=round(100 * (n_brut - len(ts)) / n_brut, 2)))\n",
    "    f = features_par_cycle(ts, c)\n",
    "    f.insert(0, \"cell\", c.cell_id)\n",
    "    cyc_frames.append(f)\n",
    "    for etape in ETAPES:\n",
    "        sub = ts if etape == \"toutes\" else ts[ts[\"step_type\"] == etape]\n",
    "        if len(sub) >= 100:            # cc_charge n'existe que sur 3 cellules (§5bis)\n",
    "            corr_sig[(c.cell_id, etape)] = sub[SIG].corr(method=\"spearman\")\n",
    "    del ts, f\n",
    "\n",
    "cyc_df = pd.concat(cyc_frames, ignore_index=True)\n",
    "print(f\"{len(cyc_df)} cycles agrégés, {len(corr_sig)} matrices de signaux bruts (cellule × étape)\")\n",
    "pd.DataFrame(qualite)"
   ]
